// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String    @id @default(cuid())
  name         String    @unique
  createdAt    DateTime  @default(now())
  onboardedAt  DateTime?
  goalWeightKg Float?
  stepsGoal    Int?

  nutritionTarget   NutritionTarget?
  trainingExercises TrainingExercise[]
  stepEntries       StepEntry[]
  foodEntries       FoodEntry[]
  customFoods       CustomFood[]
  waterEntries      WaterEntry[]
  weightEntries     WeightEntry[]
}

model TrainingExercise {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  // 0 = Monday ... 6 = Sunday
  weekday   Int
  name      String
  // "weight" (log kg + sets + reps) | "cardio" (log km)
  kind      String
  order     Int
  createdAt DateTime @default(now())

  logs ExerciseLog[]
}

model ExerciseLog {
  id         String           @id @default(cuid())
  exercise   TrainingExercise @relation(fields: [exerciseId], references: [id])
  exerciseId String
  // Start (Monday) of the calendar week this log applies to
  weekStart  DateTime
  kg         Float?
  sets       Int?
  reps       Int?
  km         Float?
  loggedAt   DateTime         @default(now())

  @@unique([exerciseId, weekStart])
}

model StepEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  steps     Int

  @@unique([profileId, date])
}

model NutritionTarget {
  id           String  @id @default(cuid())
  profile      Profile @relation(fields: [profileId], references: [id])
  profileId    String  @unique
  calories     Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  waterTargetMl Int    @default(2000)
}

model WaterEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())
}

model WeightEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  weightKg  Float

  @@unique([profileId, date])
}

model FoodEntry {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  date        DateTime
  name        String
  calories    Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  source      String   // "openfoodfacts" | "custom" | "manual"
  sourceRef   String?  // barcode / id from Open Food Facts
  createdAt   DateTime @default(now())
}

model CustomFood {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String
  name      String
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float
}
