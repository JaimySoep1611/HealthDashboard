// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  nutritionTarget  NutritionTarget?
  trainingGoals    TrainingGoal[]
  stepEntries      StepEntry[]
  foodEntries      FoodEntry[]
  customFoods      CustomFood[]
}

model TrainingGoal {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  name      String
  order     Int
  createdAt DateTime @default(now())

  completions GoalCompletion[]
}

model GoalCompletion {
  id          String       @id @default(cuid())
  goal        TrainingGoal @relation(fields: [goalId], references: [id])
  goalId      String
  // Start (Monday) of the calendar week this completion applies to
  weekStart   DateTime
  completedAt DateTime     @default(now())

  @@unique([goalId, weekStart])
}

model StepEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  steps     Int

  @@unique([profileId, date])
}

model NutritionTarget {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @unique
  calories  Int
  proteinG  Int
  carbsG    Int
  fatG      Int
}

model FoodEntry {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  date        DateTime
  name        String
  calories    Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  source      String   // "openfoodfacts" | "custom" | "manual"
  sourceRef   String?  // barcode / id from Open Food Facts
  createdAt   DateTime @default(now())
}

model CustomFood {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String
  name      String
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float
}
