// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               String    @id @default(cuid())
  name             String    @unique
  createdAt        DateTime  @default(now())
  onboardedAt      DateTime?
  goalWeightKg     Float?
  stepsGoal        Int?
  startingWeightKg Float?
  funBackground    Boolean   @default(false)

  nutritionTarget   NutritionTarget?
  trainingExercises TrainingExercise[]
  stepEntries       StepEntry[]
  foodEntries       FoodEntry[]
  waterEntries      WaterEntry[]
  weightEntries     WeightEntry[]
  pushSubscriptions PushSubscription[]
  stravaConnection  StravaConnection?
}

model StravaConnection {
  id           String   @id @default(cuid())
  profile      Profile  @relation(fields: [profileId], references: [id])
  profileId    String   @unique
  athleteId    String   @unique
  athleteName  String?
  accessToken  String
  refreshToken String
  // Unix seconds — Strava's token response format, compared directly against
  // Math.floor(Date.now() / 1000) rather than converting to a Date.
  expiresAt    Int
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model TrainingExercise {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  // 0 = Monday ... 6 = Sunday
  weekday   Int
  name      String
  // "weight" (log kg + sets + reps) | "cardio" (log km)
  kind      String
  order     Int
  createdAt DateTime @default(now())

  logs ExerciseLog[]
}

model ExerciseLog {
  id         String           @id @default(cuid())
  exercise   TrainingExercise @relation(fields: [exerciseId], references: [id])
  exerciseId String
  // Start (Monday) of the calendar week this log applies to
  weekStart  DateTime
  kg         Float?
  sets       Int?
  reps       Int?
  km         Float?
  loggedAt   DateTime         @default(now())

  // Present only when this log was synced in automatically from Strava —
  // extra detail for the "view details" popup, beyond the plain km the
  // schedule already shows for a manually-logged run.
  stravaActivityId String? @unique
  movingTimeSec    Int?
  elevationGainM   Float?
  avgSpeedMps      Float?

  @@unique([exerciseId, weekStart])
}

model StepEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  steps     Int

  @@unique([profileId, date])
}

model NutritionTarget {
  id            String  @id @default(cuid())
  profile       Profile @relation(fields: [profileId], references: [id])
  profileId     String  @unique
  calories      Int
  proteinG      Int
  carbsG        Int
  fatG          Int
  waterTargetMl Int     @default(2000)
}

model WaterEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())
}

model WeightEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  weightKg  Float

  @@unique([profileId, date])
}

model FoodEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  date      DateTime
  name      String
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  source    String // "openfoodfacts" | "custom" | "manual"
  sourceRef String? // barcode / id from Open Food Facts
  createdAt DateTime @default(now())
}

// Not profile-scoped on purpose — a shared "go-to meals" menu both
// household profiles see and pick from, same as the household shares one
// fridge. Distinct from FoodEntry (an actual logged meal on a given day).
model FavoriteMeal {
  id        String   @id @default(cuid())
  name      String
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  createdAt DateTime @default(now())
}
